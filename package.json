{
    "name": "onboardly-server",
    "version": "1.0.0",
    "main": "index.js",
    "author": "Joynal Abedin",
    "license": "MIT",
    "scripts": {
        "dev": "node --no-warnings --watch -r @swc-node/register -- ./src/index.ts",
        "build": "tsc",
        "start": "node ./build",
        "lint": "eslint",
        "db:migrate:make": "node -r @swc-node/register node_modules/.bin/knex migrate:make",
        "db:migrate:run": "node -r @swc-node/register node_modules/.bin/knex migrate:latest",
        "tools:generate:certs": "node --no-warnings --watch -r @swc-node/register -r dotenv/config -- ./src/tools/generateCerts.ts"
    },
    "devDependencies": {
        "@eslint/js": "^9.17.0",
        "@swc-node/register": "^1.10.9",
        "@types/cls-hooked": "^4.3.9",
        "@types/cors": "^2.8.17",
        "@types/express": "^5.0.0",
        "@types/node": "^22.10.2",
        "@types/pg": "^8.11.10",
        "@types/pino": "^7.0.5",
        "@types/swagger-ui-express": "^4.1.7",
        "@types/uuid": "^10.0.0",
        "eslint": "^9.17.0",
        "eslint-config-prettier": "^9.1.0",
        "eslint-plugin-import": "^2.31.0",
        "eslint-plugin-prettier": "^5.2.1",
        "eslint-plugin-security": "3.0.1",
        "eslint-plugin-sonarjs": "^3.0.1",
        "prettier": "^3.4.2",
        "typescript": "^5.7.2",
        "typescript-eslint": "^8.18.2"
    },
    "dependencies": {
        "@anatine/zod-openapi": "^2.2.6",
        "cls-hooked": "^4.2.2",
        "cors": "^2.8.5",
        "express": "^5.0.1",
        "helmet": "^8.0.0",
        "http-status-codes": "^2.3.0",
        "jose": "^5.9.6",
        "knex": "^3.1.0",
        "msw": "^2.7.4",
        "pg": "^8.13.1",
        "pino": "^9.6.0",
        "pino-http": "^10.3.0",
        "pino-pretty": "^13.0.0",
        "swagger-ui-express": "^5.0.1",
        "uuid": "^11.0.3",
        "zod": "^3.24.1"
    }
}
