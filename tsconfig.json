{
    "compilerOptions": {
        "target": "es2022",
        "lib": [
            "es2015",
            "es2017",
            "dom"
        ],
        "module": "esnext",
        "moduleResolution": "node",
        "baseUrl": "./src",
        "outDir": "./build",
        "declaration": true,
        "types": [
            "node"
        ],
        "rootDir": "src",
        "resolveJsonModule": true,
        "esModuleInterop": true,
        "forceConsistentCasingInFileNames": true,
        "strict": true,
        "skipLibCheck": true,
        "noImplicitAny": true,
        "strictNullChecks": true,
        "preserveSymlinks": true,
        "experimentalDecorators": true,
        "emitDecoratorMetadata": true,
        "sourceMap": true
    },
    "include": [
        "src/**/*.ts",
    ],
    "exclude": [
        "node_modules"
    ]
}
